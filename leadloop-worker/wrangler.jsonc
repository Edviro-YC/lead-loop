{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "leadloop-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-10",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"upload_source_maps": true,
	"placement": { "mode": "smart" },

	// All vars and secrets are set via .dev.vars (local) or
	// Cloudflare dashboard > Settings > Variables and Secrets (production).
	// See .dev.vars.example for the full list.

	"queues": {
		"producers": [
			{ "binding": "FOLLOW_UP_DRAFT_QUEUE", "queue": "leadloop-follow-up-draft" },
			{ "binding": "EMBED_EXAMPLE_QUEUE", "queue": "leadloop-embed-example" }
		],
		"consumers": [
			{ "queue": "leadloop-follow-up-draft", "max_batch_size": 5, "max_retries": 3 },
			{ "queue": "leadloop-embed-example", "max_batch_size": 10, "max_retries": 3 }
		]
	},

	"triggers": {
		"crons": [
			"*/10 * * * *"
		]
	}
}
