# Copy this file to .dev.vars and fill in your values.
# These override wrangler.jsonc vars for local dev and wrangler deploy.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
DASHBOARD_URL=https://leadloop-dashboard.YOUR_SUBDOMAIN.workers.dev

# Secrets
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GOOGLE_CLIENT_ID=123456789.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
ADDON_API_KEY=generate-a-random-string
MCP_API_KEY=generate-a-different-random-string

# Optional: enable verbose timing/debug logs
# DEBUG=true
