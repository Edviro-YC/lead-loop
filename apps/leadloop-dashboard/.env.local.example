# Copy this file to .env.local and fill in your values.
# NEXT_PUBLIC_* vars are inlined at build time, so they must be set
# before running `npm run build` or `npm run deploy`.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_WORKER_URL=https://leadloop-worker.YOUR_SUBDOMAIN.workers.dev
